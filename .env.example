# Get from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Get from resend.com → API Keys (free, sign up with Google)
RESEND_API_KEY=your_resend_key_here

# Your verified Resend sender address (e.g. radar@yourdomain.com or onboarding@resend.dev)
RESEND_FROM_EMAIL=Growth Radar <onboarding@resend.dev>

# Your email address — where the intelligence report is sent
ALERT_EMAIL=your@email.com

# Optional — free at developer.ticketmaster.com (5,000 calls/day)
# Adds concerts, expos, cultural events, and conferences to your results
TICKETMASTER_API_KEY=
